{
  "name": "evolution-simulator",
  "version": "1.0.0",
  "description": "A real-time, visual evolution simulator: populations evolve over generations via mutation and emergent natural selection, with tradeoff-driven genetics.",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/build-public.mjs",
    "compile": "tsc",
    "dev": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "serve": "python3 -m http.server 8000",
    "start": "tsc && python3 -m http.server 8000"
  },
  "keywords": ["evolution", "simulation", "genetics", "natural-selection", "canvas", "typescript"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
